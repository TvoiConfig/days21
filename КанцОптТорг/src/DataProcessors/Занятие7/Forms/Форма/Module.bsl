
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДниНедели = СтрРазделить("Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье", ",");
	ТекущийКонецГода = КонецГода(ТекущаяДата());
	ЧислоГодовРасчета = 10;
	
	Для Индекс=0 По ЧислоГодовРасчета-1 Цикл
		КонецГода = ДобавитьМесяц(ТекущийКонецГода, 12*Индекс);
		ЧислоДняНедели = ДеньНедели(КонецГода);
		ДеньНедели = ДниНедели[ЧислоДняНедели-1];
		Сообщить(ДеньНедели);
	КонецЦикла;
	
КонецПроцедуры
